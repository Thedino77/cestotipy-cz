#: inc/lifecycle.php:618
msgid "<h4>WP_CACHE constant added to wp-config.php</h4><p>If you continue to see this warning message please see point 5 of the <a href=\"https://wordpress.org/plugins/wp-super-cache/faq/\">Troubleshooting Guide</a>. The WP_CACHE line must be moved up."
msgstr "<h4>Konstanta WP_CACHE přidána do wp-config.php</h4><p>Pokud stále vidíte toto varování, podívejte se na bod 5 <a href=\"https://wordpress.org/plugins/wp-super-cache/faq/\">Průvodce řešením problémů</a>. Řádek WP_CACHE musí být přesunut výše."

#: inc/lifecycle.php:614
msgid "Edit <code>%s</code> and add the following line:<br /> <code>define('WP_CACHE', true);</code><br />Otherwise, <strong>WP-Cache will not be executed</strong> by WordPress core. "
msgstr "Upravte <code>%s</code> a přidejte následující řádek:<br /> <code>define('WP_CACHE', true);</code><br />Jinak <strong>WP-Cache nebude spuštěn</strong> jádrem WordPressu. "

#: inc/lifecycle.php:613
msgid "<strong>Error: WP_CACHE is not enabled</strong> in your <code>wp-config.php</code> file and I couldn&#8217;t modify it."
msgstr "<strong>Chyba: WP_CACHE není povolen</strong> ve vašem souboru <code>wp-config.php</code> a nemohl jsem ho upravit."

#: inc/lifecycle.php:611
msgid "<h4>WP_CACHE constant set to false</h4><p>The WP_CACHE constant is used by WordPress to load the code that serves cached pages. Unfortunately, it is set to false. Please edit your wp-config.php and add or edit the following line above the final require_once command:<br /><br /><code>define('WP_CACHE', true);</code></p>"
msgstr "<h4>Konstanta WP_CACHE nastavena na false</h4><p>Konstanta WP_CACHE je používána WordPressem k načtení kódu, který obsluhuje cachované stránky. Bohužel je nastavena na false. Upravte prosím svůj wp-config.php a přidejte nebo upravte následující řádek nad příkaz require_once:<br /><br /><code>define('WP_CACHE', true);</code></p>"

#: inc/lifecycle.php:570
msgid "If that doesn&#8217;t work, make sure the file <em>%s/advanced-cache.php</em> doesn&#8217;t exist:"
msgstr "Pokud to nefunguje, ujistěte se, že soubor <em>%s/advanced-cache.php</em> neexistuje:"

#: inc/lifecycle.php:569
msgid "Refresh this page to update <em>%s/advanced-cache.php</em>"
msgstr "Obnovte tuto stránku pro aktualizaci <em>%s/advanced-cache.php</em>"

#: inc/lifecycle.php:565
msgid "Make %1$s writable using the chmod command through your ftp or server software. (<em>chmod 777 %1$s</em>) and refresh this page. This is only a temporary measure and you&#8217;ll have to make it read only afterwards again. (Change 777 to 755 in the previous command)"
msgstr "Nastavte %1$s jako zapisovatelný pomocí příkazu chmod přes vaše ftp nebo serverový software. (<em>chmod 777 %1$s</em>) a obnovte tuto stránku. Toto je pouze dočasné opatření a poté budete muset soubor znovu nastavit pouze pro čtení. (Změňte 777 na 755 v předchozím příkazu)"

#: inc/lifecycle.php:469
msgid "Could not update %s!</em> WPCACHEHOME must be set in config file."
msgstr "Nepodařilo se aktualizovat %s!</em> WPCACHEHOME musí být nastaveno v konfiguračním souboru."

#: inc/lifecycle.php:410
msgid "Sample WP-Cache config file (<strong>%s</strong>) does not exist. Verify your installation."
msgstr "Vzorový konfigurační soubor WP-Cache (<strong>%s</strong>) neexistuje. Ověřte svou instalaci."

#: inc/lifecycle.php:404
msgid "Configuration file missing and %1$s  directory (<strong>%2$s</strong>) is not writable by the web server. Check its permissions."
msgstr "Konfigurační soubor chybí a adresář %1$s (<strong>%2$s</strong>) není zapisovatelný webovým serverem. Zkontrolujte jeho oprávnění."

#: inc/lifecycle.php:399
msgid "Your WP-Cache config file (<strong>%s</strong>) is out of date and not writable by the Web server. Please delete it and refresh this page."
msgstr "Váš konfigurační soubor WP-Cache (<strong>%s</strong>) je zastaralý a není zapisovatelný webovým serverem. Prosím, smažte jej a obnovte tuto stránku."

#: inc/lifecycle.php:365
msgid "Your cache directory (<strong>%1$s</strong>) or <strong>%2$s</strong> need to be writable for this plugin to work. Double-check it."
msgstr "Váš adresář cache (<strong>%1$s</strong>) nebo <strong>%2$s</strong> musí být zapisovatelný, aby tento doplněk fungoval. Dvakrát to zkontrolujte."

#: inc/lifecycle.php:360
msgid "Your cache directory (<strong>%1$s</strong>) did not exist and couldn&#8217;t be created by the web server. Check %1$s permissions."
msgstr "Váš adresář cache (<strong>%1$s</strong>) neexistoval a nemohl být vytvořen webovým serverem. Zkontrolujte oprávnění %1$s."

#: inc/lifecycle.php:236
msgid "GZIP compression is enabled in WordPress, wp-cache will be bypassed until you disable gzip compression."
msgstr "Komprese GZIP je povolena ve WordPressu, wp-cache bude obcházen, dokud kompresi gzip nezakážete."

